# Backend Server Port
PORT=3000

# Blynk IoT Cloud Configuration (from Arduino Sketch: arduino/esp8266_icebox_monitor.ino)
BLYNK_AUTH_TOKEN=r62_bOTJPlY1gnaI79geaTMmAN8TXYvN
BLYNK_TEMPLATE_ID=TMPL3wrQDOMGm
BLYNK_TEMPLATE_NAME=ICE BOX MONITOR

# Automatic Background Polling Interval (in seconds, default: 10)
