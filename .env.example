DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cold_chain_db

# Default Device Metadata
DEFAULT_BOX_ID=BOX-001
DEFAULT_BATTERY_LEVEL=85.00
DEFAULT_LATITUDE=11.341000
